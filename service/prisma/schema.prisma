generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model app_pengaturan {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kunci               String   @unique @db.VarChar(100)
  nilai               Json
  tanggal_dibuat      DateTime @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui  DateTime @default(now()) @db.Timestamptz(6)
}

model role_permission {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                String   @db.VarChar(30)
  modul               String   @db.VarChar(50)
  can_view            Boolean  @default(false)
  can_create          Boolean  @default(false)
  can_update          Boolean  @default(false)
  can_delete          Boolean  @default(false)
  can_resolve         Boolean  @default(false)
  can_workflow        Boolean  @default(false)
  tanggal_dibuat      DateTime @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([role, modul], map: "uq_role_permission")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detail_mutasi_stok {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mutasi_stok_id     String              @db.Uuid
  jenis_barang       jenis_barang
  toner_id           String?             @db.Uuid
  printer_id         String?             @db.Uuid
  suku_cadang_id     String?             @db.Uuid
  jumlah             Decimal             @db.Decimal(14, 2)
  satuan             String              @default("pcs") @db.VarChar(30)
  keterangan         String?
  mutasi_stok        mutasi_stok         @relation(fields: [mutasi_stok_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  master_printer     master_printer?     @relation(fields: [printer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  master_suku_cadang master_suku_cadang? @relation(fields: [suku_cadang_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  master_toner       master_toner?       @relation(fields: [toner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([mutasi_stok_id], map: "idx_detail_mutasi_stok")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model master_gudang {
  id                                                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_gudang                                             String                         @unique @db.VarChar(50)
  nama_gudang                                             String                         @db.VarChar(150)
  jenis_gudang                                            jenis_gudang
  teknisi_id                                              String?                        @db.Uuid
  alamat                                                  String?
  aktif                                                   Boolean                        @default(true)
  tanggal_dibuat                                          DateTime                       @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui                                      DateTime                       @default(now()) @db.Timestamptz(6)
  master_pengguna                                         master_pengguna?               @relation(fields: [teknisi_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mutasi_stok_mutasi_stok_gudang_asal_idTomaster_gudang   mutasi_stok[]                  @relation("mutasi_stok_gudang_asal_idTomaster_gudang")
  mutasi_stok_mutasi_stok_gudang_tujuan_idTomaster_gudang mutasi_stok[]                  @relation("mutasi_stok_gudang_tujuan_idTomaster_gudang")
  pemakaian_barang_surat_tugas                            pemakaian_barang_surat_tugas[]
  master_printer                                         master_printer[]
  stok_suku_cadang                                        stok_suku_cadang[]
  stok_toner                                              stok_toner[]
  surat_tugas_baru                                         surat_tugas[] @relation("surat_tugas_gudang_baru")

  @@index([teknisi_id], map: "idx_gudang_teknisi")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model master_kontrak {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id             String                  @db.Uuid
  nomor_kontrak           String                  @unique @db.VarChar(100)
  tanggal_mulai           DateTime                @db.Date
  tanggal_selesai         DateTime?               @db.Date
  jenis_layanan           String                  @db.VarChar(100)
  sla_respon_jam          Int                     @default(0)
  sla_penyelesaian_jam    Int                     @default(0)
  status                  String                  @default("aktif") @db.VarChar(50)
  keterangan              String?
  tanggal_dibuat          DateTime                @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui      DateTime                @default(now()) @db.Timestamptz(6)
  tiket_id                String?                 @unique @db.Uuid
  master_customer         master_customer         @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  tiket_asal              tiket?                   @relation("kontrak_tiket_asal", fields: [tiket_id], references: [id], onUpdate: NoAction)
  tiket                   tiket[]                  @relation("tiket_kontrak")
  master_printer          master_printer[]
  surat_tugas             surat_tugas[]

  @@index([customer_id], map: "idx_kontrak_customer")
}

model master_customer {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id               String                     @db.Uuid
  kode_customer            String                     @db.VarChar(50)
  nama_customer            String                     @db.VarChar(200)
  alamat                   String
  nama_pic                 String?                    @db.VarChar(150)
  telepon_pic              String?                    @db.VarChar(50)
  email_pic                String?                    @db.VarChar(150)
  aktif                    Boolean                    @default(true)
  tanggal_dibuat           DateTime                   @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui       DateTime                   @default(now()) @db.Timestamptz(6)
  master_kontrak           master_kontrak[]
  master_account           master_account             @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  master_printer          master_printer[]
  pengaduan                pengaduan[]
  surat_tugas              surat_tugas[]
  tiket                    tiket[]

  @@unique([account_id, kode_customer], map: "uq_customer_account_kode")
  @@index([account_id], map: "idx_customer_account")
}

model master_account {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_account            String                    @unique @db.VarChar(50)
  nama_account            String                    @db.VarChar(200)
  npwp                    String?                   @db.VarChar(50)
  telepon                 String?                   @db.VarChar(50)
  email                   String?                   @db.VarChar(150)
  alamat_penagihan        String?
  aktif                   Boolean                   @default(true)
  tanggal_dibuat          DateTime                  @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui      DateTime                  @default(now()) @db.Timestamptz(6)
  master_customer         master_customer[]
  master_printer          master_printer[]
  pengaduan               pengaduan[]
  surat_tugas             surat_tugas[]
  tiket                   tiket[]
}

model master_pengguna {
  id                                                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                 String?               @unique @db.VarChar(20)
  nama                                                    String                @db.VarChar(150)
  email                                                   String?               @unique @db.VarChar(150)
  telepon                                                 String?               @db.VarChar(50)
  peran                                                   peran_pengguna
  aktif                                                   Boolean               @default(true)
  tanggal_dibuat                                          DateTime              @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui                                      DateTime              @default(now()) @db.Timestamptz(6)
  kata_sandi_hash                                         String?
  master_gudang                                           master_gudang[]
  mutasi_stok                                             mutasi_stok[]
  pengaduan                                               pengaduan[]
  riwayat_audit                                           riwayat_audit[]
  surat_tugas_surat_tugas_dibuat_olehTomaster_pengguna    surat_tugas[]         @relation("surat_tugas_dibuat_olehTomaster_pengguna")
  surat_tugas_surat_tugas_disetujui_olehTomaster_pengguna surat_tugas[]         @relation("surat_tugas_disetujui_olehTomaster_pengguna")
  surat_tugas_validasi_warehouse_olehTomaster_pengguna     surat_tugas[]         @relation("surat_tugas_validasi_warehouse_olehTomaster_pengguna")
  surat_tugas_validasi_kepala_olehTomaster_pengguna        surat_tugas[]         @relation("surat_tugas_validasi_kepala_olehTomaster_pengguna")
  teknisi_surat_tugas                                     teknisi_surat_tugas[]
  tiket_dibuat                                            tiket[] @relation("tiket_dibuat_oleh")
  tiket_sales                                             tiket[] @relation("tiket_sales")
  surat_tugas_pic_warehouse                               surat_tugas[] @relation("surat_tugas_pic_warehouse")

  @@index([email], map: "idx_master_pengguna_email")
}

model master_printer_kategori {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_kategori      String                 @unique @db.VarChar(50)
  nama_kategori      String                 @db.VarChar(150)
  aktif              Boolean                @default(true)
  tanggal_dibuat     DateTime               @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui DateTime               @default(now()) @db.Timestamptz(6)
  master_printer_model master_printer_model[]
}

model master_printer_model {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kategori_id        String                  @db.Uuid
  kode_model         String                  @unique @db.VarChar(50)
  merek              String                  @db.VarChar(100)
  nama_model         String                  @db.VarChar(150)
  aktif              Boolean                 @default(true)
  tanggal_dibuat     DateTime                @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui DateTime                @default(now()) @db.Timestamptz(6)
  master_printer_kategori master_printer_kategori @relation(fields: [kategori_id], references: [id], onUpdate: NoAction)
  master_printer     master_printer[]
  tiket_printer      tiket_printer[]
  surat_tugas_printer surat_tugas_printer[]

  @@index([kategori_id], map: "idx_printer_model_kategori")
}

model master_printer {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mp_no                        String                         @unique @db.VarChar(150)
  serial_number                String?                        @unique @db.VarChar(150)
  model_id                     String                         @db.Uuid
  gudang_id                    String?                        @db.Uuid
  account_id                   String?                        @db.Uuid
  customer_id                  String?                        @db.Uuid
  surat_tugas_aktif_id         String?                        @db.Uuid
  status                       String                         @default("available") @db.VarChar(20)
  lokasi_detail                String?                        @db.VarChar(200)
  tanggal_pembelian            DateTime?                      @db.Date
  tanggal_instalasi            DateTime?                      @db.Date
  tanggal_maintenance_berikutnya DateTime?                    @db.Date
  interval_maintenance_bulan   Int?
  meter_hitam_putih            Int                            @default(0)
  meter_warna                  Int                            @default(0)
  keterangan                   String?
  lokasi_jenis                 String                         @default("gudang") @db.VarChar(20)
  penempatan                   String                         @default("none") @db.VarChar(30)
  kondisi                      String                         @default("ready") @db.VarChar(30)
  kontrak_id                   String?                        @db.Uuid
  lokasi_internal              String?                        @db.VarChar(200)
  tanggal_dibuat               DateTime                       @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui           DateTime                       @default(now()) @db.Timestamptz(6)
  master_printer_model         master_printer_model           @relation(fields: [model_id], references: [id], onUpdate: NoAction)
  master_gudang                master_gudang?                 @relation(fields: [gudang_id], references: [id], onUpdate: NoAction)
  master_account               master_account?                @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  master_customer              master_customer?               @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  master_kontrak               master_kontrak?                @relation(fields: [kontrak_id], references: [id], onUpdate: NoAction)
  surat_tugas_aktif            surat_tugas?                   @relation("printer_active_wo", fields: [surat_tugas_aktif_id], references: [id], onUpdate: NoAction)
  detail_mutasi_stok           detail_mutasi_stok[]
  pemakaian_barang_surat_tugas pemakaian_barang_surat_tugas[]
  pengaduan                    pengaduan[]
  surat_tugas                  surat_tugas[]                  @relation("printer_target_wo")
  surat_tugas_unit_asal        surat_tugas[]                  @relation("printer_unit_asal")
  tiket_printer                tiket_printer[]
  surat_tugas_printer          surat_tugas_printer[]

  @@index([model_id], map: "idx_printer_model")
  @@index([status, gudang_id], map: "idx_printer_location")
  @@index([customer_id, status], map: "idx_printer_customer")
}

model master_suku_cadang {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_suku_cadang             String                         @unique @db.VarChar(50)
  nama_suku_cadang             String                         @db.VarChar(200)
  aktif                        Boolean                        @default(true)
  tanggal_dibuat               DateTime                       @default(now()) @db.Timestamptz(6)
