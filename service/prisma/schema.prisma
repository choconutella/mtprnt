model master_toner {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_toner                   String                         @unique @db.VarChar(50)
  nama_toner                   String                         @db.VarChar(200)
  warna                        String?                        @db.VarChar(50)
  tipe                         String?                        @db.VarChar(100)
