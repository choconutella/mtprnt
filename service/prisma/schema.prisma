  model_printer_kompatibel     String?
  satuan                       String                         @default("pcs") @db.VarChar(30)
  aktif                        Boolean                        @default(true)
  tanggal_dibuat               DateTime                       @default(now()) @db.Timestamptz(6)
  tanggal_diperbarui           DateTime                       @default(now()) @db.Timestamptz(6)
  detail_mutasi_stok           detail_mutasi_stok[]
  pemakaian_barang_surat_tugas pemakaian_barang_surat_tugas[]
  stok_toner                   stok_toner[]
  tiket_barang                 tiket_barang[]
}

model mutasi_stok {
  id                                                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomor_mutasi                                              String               @unique @db.VarChar(100)
  jenis_mutasi                                              jenis_mutasi_stok
  tanggal_mutasi                                            DateTime             @default(now()) @db.Timestamptz(6)
  gudang_asal_id                                            String?              @db.Uuid
  gudang_tujuan_id                                          String?              @db.Uuid
  jenis_referensi                                           String?              @db.VarChar(50)
  referensi_id                                              String?              @db.Uuid
  status                                                    status_mutasi_stok   @default(draft)
  keterangan                                                String?
  dibuat_oleh                                               String?              @db.Uuid
  tanggal_dibuat                                            DateTime             @default(now()) @db.Timestamptz(6)
  tanggal_terposting                                        DateTime?            @db.Timestamptz(6)
  detail_mutasi_stok                                        detail_mutasi_stok[]
  master_pengguna                                           master_pengguna?     @relation(fields: [dibuat_oleh], references: [id], onDelete: Restrict, onUpdate: NoAction)
  master_gudang_mutasi_stok_gudang_asal_idTomaster_gudang   master_gudang?       @relation("mutasi_stok_gudang_asal_idTomaster_gudang", fields: [gudang_asal_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  master_gudang_mutasi_stok_gudang_tujuan_idTomaster_gudang master_gudang?       @relation("mutasi_stok_gudang_tujuan_idTomaster_gudang", fields: [gudang_tujuan_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tanggal_mutasi], map: "idx_mutasi_stok_tanggal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pemakaian_barang_surat_tugas {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surat_tugas_id     String              @db.Uuid
  gudang_id          String              @db.Uuid
  jenis_barang       jenis_barang
  toner_id           String?             @db.Uuid
  printer_id         String?             @db.Uuid
  suku_cadang_id     String?             @db.Uuid
  jumlah_pakai       Decimal             @db.Decimal(14, 2)
  serial_number      String?             @db.VarChar(150)
  keterangan         String?
  master_gudang      master_gudang       @relation(fields: [gudang_id], references: [id], onUpdate: NoAction)
  master_printer     master_printer?     @relation(fields: [printer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  master_suku_cadang master_suku_cadang? @relation(fields: [suku_cadang_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  surat_tugas        surat_tugas         @relation(fields: [surat_tugas_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  master_toner       master_toner?       @relation(fields: [toner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([surat_tugas_id], map: "idx_pemakaian_surat_tugas")
}

