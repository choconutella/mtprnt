{
  "name": "multiprint-service",
  "version": "1.0.0",
  "description": "Backend Express.js untuk aplikasi Multiprint.",
  "main": "src/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "test:printer": "node --test test/printer-unit.test.js",
    "test:import": "node --test test/master-import.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^3.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.14.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
